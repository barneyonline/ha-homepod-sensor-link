# Pinned upstream HACS validator, also used by ha-enphase-energy.
ARG HACS_SOURCE_PLATFORM=linux/amd64
FROM --platform=${HACS_SOURCE_PLATFORM} ghcr.io/hacs/action@sha256:a0336b447da4500204122cabea01cac1e0992840d8b927535782ddd5b601f698 AS validator
FROM ghcr.io/home-assistant/home-assistant@sha256:c6c1ca9931036bf3a2c4cc088d8db25dfea3b33935a5ecc83c40349462e2f69e
COPY --from=validator /hacs /hacs
WORKDIR /hacs
RUN python3 -c "from homeassistant.const import __version__; assert __version__ == '2026.11.0'"
ENTRYPOINT ["python3", "/hacs/action.py"]
